FROM python@sha256:f9fa7f851e38bfb19c9de3afbc4b86ae7176ea7aaf94535c31df5458d5849457
ARG IPTABLES_VERSION=1.8.11-2
RUN apt-get -o Acquire::AllowInsecureRepositories=false -o Acquire::AllowDowngradeToInsecureRepositories=false update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get -o APT::Get::AllowUnauthenticated=false install -y -qq --no-install-recommends "iptables=${IPTABLES_VERSION}" \
    && mkdir -p /opt/factory/provenance \
    && cp /var/lib/apt/lists/*_InRelease /opt/factory/provenance/ \
    && cp /usr/share/keyrings/debian-archive-keyring.gpg /opt/factory/provenance/ \
    && dpkg-query -W -f='${Package}\t${Version}\n' > /opt/factory/provenance/packages.tsv \
    && rm -rf /var/lib/apt/lists/*
